# OVERWATCH boot splash: a random Half-Life 2 chapter image, the emblem, and a progress bar.

Window.SetBackgroundTopColor(0.039, 0.059, 0.078);
Window.SetBackgroundBottomColor(0.016, 0.027, 0.039);

sw = Window.GetWidth();
sh = Window.GetHeight();

# Backdrop: one of four, scaled to cover the screen
pick = Math.Int(Math.Random() * 4);
if (pick > 3) pick = 3;
bg.image = Image("bg" + pick + ".png");
ratio = sw / bg.image.GetWidth();
if (sh / bg.image.GetHeight() > ratio) ratio = sh / bg.image.GetHeight();
bg.image = bg.image.Scale(bg.image.GetWidth() * ratio, bg.image.GetHeight() * ratio);
bg.sprite = Sprite(bg.image);
bg.sprite.SetPosition(Window.GetX() + sw / 2 - bg.image.GetWidth() / 2, Window.GetY() + sh / 2 - bg.image.GetHeight() / 2, 0);

logo.image = Image("logo.png");
scale = sw / 2560;
if (scale > 1) scale = 1;
if (scale < 0.5) scale = 0.5;
logo.image = logo.image.Scale(logo.image.GetWidth() * scale, logo.image.GetHeight() * scale);
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + sw / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + sh / 2 - logo.image.GetHeight() / 2 - 40 * scale;
logo.sprite.SetPosition(logo.x, logo.y, 2);

# Progress bar: a thin track with a bright fill and end ticks, nothing behind it
track.image = Image("track.png");
track.sprite = Sprite(track.image);
bar.x = Window.GetX() + sw / 2 - track.image.GetWidth() / 2;
bar.y = logo.y + logo.image.GetHeight() + 26;
track.sprite.SetPosition(bar.x, bar.y, 2);
frame.y = bar.y;

fill.image = Image("fill.png");
fill.sprite = Sprite();
fill.sprite.SetPosition(bar.x, bar.y, 3);

tick = 0;
fun refresh_callback() {
    tick++;
    logo.sprite.SetOpacity(0.84 + 0.16 * Math.Sin(tick / 18));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
    w = Math.Int(fill.image.GetWidth() * progress);
    if (w < 2) w = 2;
    fill.sprite.SetImage(fill.image.Crop(0, 0, w, fill.image.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Disk password prompt
bullet.image = Image("bullet.png");
prompt.sprite = Sprite();
bullets = [];
fun display_password_callback(text, count) {
    prompt.image = Image.Text(text, 0.37, 0.84, 0.91);
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(Window.GetX() + sw / 2 - prompt.image.GetWidth() / 2, frame.y + 60, 4);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
    for (i = 0; i < count; i++) {
        if (!bullets[i]) bullets[i] = Sprite(bullet.image);
        bullets[i].SetOpacity(1);
        bullets[i].SetPosition(Window.GetX() + sw / 2 - count * 8 + i * 16, frame.y + 96, 4);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

message.sprite = Sprite();
fun message_callback(text) {
    message.image = Image.Text(text, 0.44, 0.54, 0.58);
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(Window.GetX() + sw / 2 - message.image.GetWidth() / 2, Window.GetY() + sh - 80, 4);
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback() { logo.sprite.SetOpacity(1); }
Plymouth.SetQuitFunction(quit_callback);
