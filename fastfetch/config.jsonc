{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/emblem.txt",
    "color": { "1": "38;2;95;215;232", "2": "38;2;230;246;250" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;95;215;232", "output": "38;2;207;234;240" }
  },
  "modules": [
    { "type": "custom", "format": "\u001b[38;2;95;215;232mOVERWATCH // CIVIL PROTECTION TERMINAL\u001b[0m" },
    { "type": "custom", "format": "\u001b[38;2;74;93;104m────────────────────────────────────\u001b[0m" },
    { "type": "title", "key": "UNIT     ", "format": "{user-name}" },
    { "type": "host", "key": "SECTOR   ", "format": "{name}" },
    { "type": "os", "key": "PROTOCOL ", "format": "{pretty-name}" },
    { "type": "kernel", "key": "CORE     ", "format": "{release}" },
    { "type": "wm", "key": "INTERFACE" },
    { "type": "cpu", "key": "SYNAPSE  ", "format": "{name}" },
    { "type": "gpu", "key": "OPTICS   ", "format": "{name}" },
    { "type": "memory", "key": "MEMORY   " },
    { "type": "disk", "key": "STORAGE  ", "folders": "/" },
    { "type": "battery", "key": "STABILITY" },
    { "type": "uptime", "key": "ON DUTY  " },
    { "type": "custom", "format": "\u001b[38;2;74;93;104m────────────────────────────────────\u001b[0m" },
    { "type": "colors", "symbol": "square" }
  ]
}
